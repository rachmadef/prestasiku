APP_NAME=PrestasiKu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.domainanda.com
FRONTEND_URL=https://domainanda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Konfigurasi Database MySQL di cPanel (Buat database & user di cPanel MySQL Database Wizard)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_prestasiku
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=password_database_anda

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mail.domainanda.com
MAIL_PORT=465
MAIL_USERNAME=admin@domainanda.com
MAIL_PASSWORD=password_email_anda
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@domainanda.com"
MAIL_FROM_NAME="${APP_NAME}"

# AI Services
GEMINI_API_KEY=""
GROQ_API_KEY=""
