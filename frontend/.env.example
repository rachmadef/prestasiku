# URL Backend API Laravel
# Jika frontend dan backend di domain yang sama (misal: domain.com dan API di domain.com/api):
# VITE_API_BASE_URL=/api/v1
#
# Jika backend di subdomain atau domain terpisah (misal: api.domain.com):
# VITE_API_BASE_URL=https://api.domainanda.com/api/v1
# VITE_STORAGE_BASE_URL=https://api.domainanda.com/storage

VITE_API_BASE_URL=/api/v1
